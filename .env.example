# MoonCake_BE API address (default: http://localhost:5000/api, the host port mapped to the container's 8080)
VITE_API_BASE_URL=http://localhost:5000/api

# Supabase Storage (static images). The bucket is public, so only the URL and bucket name are needed to show images.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_BUCKET=images
# Public (anon/publishable) key. Not used yet; only needed when the frontend calls Supabase directly.
VITE_SUPABASE_ANON_KEY=
VITE_VIETMAP_API_KEY=
VITE_VIETMAP_TILEMAP_KEY=
